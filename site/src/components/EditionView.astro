---
import EditionControls from './EditionControls';
import {
  formatIssueNo,
  formatLongDate,
  formatShortDate,
  splitEditionBody,
  type EditionEntry,
} from '../lib/editions';
import { renderEditorialMarkdown } from '../lib/markdown';

interface Neighbor {
  date: string;
  issue_number: number;
  title: string;
}

interface Props {
  edition: EditionEntry;
  prevIssue: Neighbor | null;
  nextIssue: Neighbor | null;
  isFrontPage?: boolean;
}

const { edition, prevIssue, nextIssue, isFrontPage = false } = Astro.props;
const d = edition.data;
const split = splitEditionBody(edition.body || '');
const summaryHtml = renderEditorialMarkdown(split.summaryMarkdown);
const deepDiveHtml = renderEditorialMarkdown(split.deepDiveMarkdown);
const coverageHtml = renderEditorialMarkdown(split.coverageMarkdown);
const prov = d.provenance;
---

<article class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 pt-8 sm:pt-10 pb-8">
  <!-- Monumental Broadsheet Masthead / Issue Header -->
  <header class="border-t-2 border-[var(--ink)] pt-4 pb-6 border-b border-[var(--rule)]">
    {isFrontPage ? (
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-[var(--ink)] mb-5">
        <div class="shrink-0">
          <div class="font-mono-telemetry text-[11px] uppercase tracking-[0.14em] text-[var(--vermilion)] font-semibold mb-1.5">
            Morning Technical Broadsheet · Reproducible AI &amp; Open-Source Wire
          </div>
          <h1 class="font-serif-display text-[clamp(2.65rem,5.4vw,4.55rem)] font-bold leading-[0.94] tracking-[-0.035em] text-[var(--ink)] sm:whitespace-nowrap">
            Daily Brief
          </h1>
        </div>
        <div class="md:text-right font-mono-telemetry text-xs text-[var(--ink-secondary)] space-y-1 max-w-md">
          <div class="font-semibold text-[var(--ink)] uppercase tracking-wider">
            {formatLongDate(d.date)}
          </div>
          <div class="leading-relaxed">
            ISSUE {formatIssueNo(d.issue_number)} · {d.window}
          </div>
        </div>
      </div>
    ) : (
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--ink)] mb-6 font-mono-telemetry text-xs">
        <div class="flex flex-wrap items-center gap-2.5">
          <a href="/archive/" class="text-[var(--ink-muted)] hover:text-[var(--vermilion)] no-underline uppercase tracking-wider">
            ← Archive
          </a>
          <span class="text-[var(--rule)]">/</span>
          <span class="font-semibold text-[var(--vermilion)]">ISSUE {formatIssueNo(d.issue_number)}</span>
          <span class="text-[var(--rule)]">·</span>
          <span class="text-[var(--ink)] font-medium uppercase tracking-wider">{formatLongDate(d.date)}</span>
        </div>
        <div class="text-[var(--ink-muted)]">{d.window}</div>
      </div>
    )}

    <!-- Provenance Telemetry Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 font-mono-telemetry text-[11px] text-[var(--ink-muted)] pb-6 border-b border-[var(--rule)]">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
        {prov?.candidates != null && (
          <span>
            <strong class="text-[var(--ink)]">{prov.candidates.toLocaleString()}</strong> CANDIDATES SCANNED
          </span>
        )}
        {prov?.revision && (
          <span>
            PINNED REV <strong class="text-[var(--ink)]">{prov.revision}</strong>
          </span>
        )}
        <span>
          <strong class="text-[var(--ink)]">{d.story_count}</strong> STORIES ·{' '}
          <strong class="text-[var(--ink)]">{d.source_count}</strong> PRIMARY SOURCES
        </span>
        <span>
          <strong class="text-[var(--ink)]">{d.reading_time_min} MIN</strong> READ
        </span>
      </div>
      <div class="flex items-center gap-2">
        {prov?.verified ? (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-[2px] bg-[var(--sage-soft)] text-[var(--sage)] font-medium uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--sage)]" aria-hidden="true"></span>
            Verified Readback
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-[2px] bg-[var(--tint)] text-[var(--ink-secondary)] font-medium uppercase tracking-wider">
            Archival Edition
          </span>
        )}
      </div>
    </div>

    <!-- 12-Column Asymmetric Hero Spread -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-6 items-start">
      <div class="lg:col-span-8 space-y-6">
        <div class="flex flex-wrap items-center gap-2 hero-rise">
          <span class="font-mono-telemetry text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--vermilion)]">
            {isFrontPage ? `Lead Edition · ${formatShortDate(d.date)}` : `Edition ${formatIssueNo(d.issue_number)}`}
          </span>
          {d.tags.map((tag) => (
            <span class="font-mono-telemetry text-[10px] uppercase tracking-wider px-2 py-0.5 bg-[var(--sheet)] border border-[var(--rule)] rounded-[2px] text-[var(--ink-secondary)]">
              {tag}
            </span>
          ))}
        </div>

        {isFrontPage ? (
          <h2 class="hero-rise-delay-1 font-serif-display text-[clamp(2.15rem,4.1vw,3.45rem)] font-bold leading-[1.06] tracking-[-0.03em] text-[var(--ink)]">
            {d.title}
          </h2>
        ) : (
          <h1 class="hero-rise-delay-1 font-serif-display text-[clamp(2.15rem,4.1vw,3.45rem)] font-bold leading-[1.06] tracking-[-0.03em] text-[var(--ink)]">
            {d.title}
          </h1>
        )}

        <!-- 90-Second Executive Brief Box -->
        <section
          id="summary-brief"
          aria-labelledby="summary-brief-title"
          class="hero-rise-delay-2 border border-[var(--ink)] bg-[var(--sheet)] rounded-[4px] p-5 sm:p-6 shadow-[4px_4px_0px_var(--tint)]"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-4 border-b border-[var(--rule)]">
            <h3 id="summary-brief-title" class="font-mono-telemetry text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--vermilion)]">
              Today in 90 Seconds
            </h3>
            <div class="flex items-center gap-2">
              <button
                type="button"
                onclick="window.dispatchEvent(new CustomEvent('db:set-mode', { detail: 'brief' }))"
                class="font-mono-telemetry text-[10px] uppercase tracking-wider px-2 py-1 border border-[var(--rule)] hover:border-[var(--ink)] rounded-[2px] text-[var(--ink-secondary)] hover:text-[var(--ink)] bg-[var(--paper)] transition-colors cursor-pointer"
              >
                Focus 90s Mode
              </button>
              <a
                href="#deep-dive-start"
                class="font-mono-telemetry text-[10px] uppercase tracking-wider px-2 py-1 bg-[var(--ink)] hover:bg-[var(--vermilion)] text-[var(--sheet)] rounded-[2px] no-underline transition-colors"
              >
                Full Edition ↓
              </a>
            </div>
          </div>

          {d.takeaways.length > 0 ? (
            <ol class="space-y-3.5">
              {d.takeaways.map((item, idx) => (
                <li class="flex gap-3.5 text-[0.98rem] leading-[1.62] text-[var(--ink)]">
                  <span class="font-mono-telemetry text-xs font-semibold text-[var(--vermilion)] shrink-0 pt-1">
                    0{idx + 1}
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ol>
          ) : (
            <div class="broadsheet-prose text-[0.98rem]" set:html={summaryHtml} />
          )}
        </section>
      </div>

      <!-- Right 4 Cols: Issue Dossier Card -->
      <aside class="lg:col-span-4 lg:border-l lg:border-[var(--rule)] lg:pl-7 space-y-5">
        <div class="border border-[var(--rule)] bg-[var(--sheet)] rounded-[4px] overflow-hidden">
          <div class="px-4 py-2.5 border-b border-[var(--rule)] bg-[var(--tint)] flex items-center justify-between">
            <span class="font-mono-telemetry text-[10px] uppercase tracking-[0.1em] font-semibold text-[var(--ink)]">
              Issue Dossier
            </span>
            <span class="font-mono-telemetry text-[10px] text-[var(--ink-muted)]">
              {d.date}
            </span>
          </div>

          {d.lead_image?.src ? (
            <button
              type="button"
              data-lightbox-src={d.lead_image.src}
              data-lightbox-alt={d.lead_image.alt || d.title}
              class="block w-full bg-white border-b border-[var(--rule)] p-3 cursor-zoom-in group text-left"
              aria-label={`Inspect lead image: ${d.lead_image.alt || d.title}`}
            >
              <div class="overflow-hidden rounded-[2px] flex items-center justify-center max-h-52">
                <img
                  src={d.lead_image.src}
                  alt={d.lead_image.alt || d.title}
                  class="max-h-52 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02]"
                  loading="eager"
                />
              </div>
              <span class="block mt-2 font-mono-telemetry text-[10px] text-[var(--ink-muted)] line-clamp-2">
                {d.lead_image.alt || 'Featured figure from this edition'}
              </span>
            </button>
          ) : (
            <div class="p-4 border-b border-[var(--rule)] bg-[var(--paper)]">
              <div class="font-mono-telemetry text-[10px] uppercase tracking-wider text-[var(--ink-muted)] mb-1">
                Editorial Digest
              </div>
              <p class="font-serif-display italic text-[0.98rem] text-[var(--ink-secondary)] leading-relaxed">
                Primary sources verified directly against release tags, official engineering blogs, and security advisories.
              </p>
            </div>
          )}

          <div class="p-4 space-y-3">
            <div class="grid grid-cols-3 gap-2 text-center border-b border-[var(--rule)] pb-3">
              <div>
                <div class="font-mono-telemetry text-lg font-semibold text-[var(--ink)]">{d.story_count}</div>
                <div class="font-mono-telemetry text-[10px] uppercase tracking-wider text-[var(--ink-muted)]">Stories</div>
              </div>
              <div class="border-x border-[var(--rule)]">
                <div class="font-mono-telemetry text-lg font-semibold text-[var(--ink)]">{d.source_count}</div>
                <div class="font-mono-telemetry text-[10px] uppercase tracking-wider text-[var(--ink-muted)]">Sources</div>
              </div>
              <div>
                <div class="font-mono-telemetry text-lg font-semibold text-[var(--ink)]">{d.reading_time_min}m</div>
                <div class="font-mono-telemetry text-[10px] uppercase tracking-wider text-[var(--ink-muted)]">Read</div>
              </div>
            </div>

            {split.deepDiveSections.length > 0 && (
              <div>
                <div class="font-mono-telemetry text-[10px] uppercase tracking-[0.1em] text-[var(--ink-muted)] mb-2">
                  Edition Index
                </div>
                <ol class="space-y-1">
                  {split.deepDiveSections.map((sec, idx) => (
                    <li>
                      <a
                        href={`#${sec.id}`}
                        class="flex items-baseline gap-2 text-xs text-[var(--ink-secondary)] hover:text-[var(--vermilion)] no-underline py-0.5 transition-colors"
                      >
                        <span class="font-mono-telemetry text-[10px] text-[var(--ink-muted)]">0{idx + 1}</span>
                        <span class="truncate">{sec.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        </div>
      </aside>
    </div>
  </header>

  <!-- 12-Column Deep Dive Grid -->
  <div id="deep-dive-start" class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-10 items-start">
    <div class="lg:col-span-3 lg:sticky lg:top-20">
      <EditionControls
        client:load
        date={d.date}
        sections={split.deepDiveSections}
        prevIssue={prevIssue}
        nextIssue={nextIssue}
      />
    </div>

    <div class="lg:col-span-9 lg:border-l lg:border-[var(--rule)] lg:pl-10 min-w-0">
      <div
        id="brief-mode-banner"
        class="hidden border border-[var(--ink)] bg-[var(--sheet)] rounded-[4px] p-5 mb-6 flex-wrap items-center justify-between gap-4"
      >
        <div>
          <div class="font-mono-telemetry text-[10px] uppercase tracking-[0.1em] text-[var(--vermilion)] font-semibold mb-1">
            90-Second Scan Mode Active
          </div>
          <p class="text-sm text-[var(--ink-secondary)]">
            Deep-dive sections are folded away. Browser <span class="font-mono-telemetry">⌘F</span> will still expand matching stories automatically.
          </p>
        </div>
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('db:set-mode', { detail: 'full' }))"
          class="px-3.5 py-2 bg-[var(--ink)] hover:bg-[var(--vermilion)] text-[var(--sheet)] font-mono-telemetry text-xs uppercase tracking-wider rounded-[2px] cursor-pointer shrink-0 transition-colors"
        >
          Show Full Edition
        </button>
      </div>

      <!-- Wrapper kept unstyled for hidden="until-found" compliance (search-hidden-content) -->
      <div id="deep-dive-wrapper">
        <div class="broadsheet-prose" set:html={deepDiveHtml} />

        {split.coverageMarkdown && (
          <section
            id="coverage-colophon"
            aria-label="Coverage and verification colophon"
            class="mt-12 border border-[var(--rule)] bg-[var(--sheet)] rounded-[4px] p-5 sm:p-6 reveal-card"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-[var(--rule)]">
              <span class="font-mono-telemetry text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--ink)]">
                Coverage &amp; Verification Colophon
              </span>
              {prov?.candidates != null && (
                <span class="font-mono-telemetry text-[11px] text-[var(--ink-muted)]">
                  {prov.candidates.toLocaleString()} candidates · {prov.revision || 'pinned'}
                </span>
              )}
            </div>
            <div class="broadsheet-prose text-[0.92rem] text-[var(--ink-secondary)]" set:html={coverageHtml} />
          </section>
        )}
      </div>
    </div>
  </div>
</article>
